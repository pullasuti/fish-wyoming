# Copy to .env to override run.sh defaults. All values are optional.

# Reference voice to clone (10-30 s clean WAV) and its exact transcript.
# PROMPT_WAV= (empty) turns cloning off: S2 Pro then picks its own voice.
# Note: with a calm reference, S2 Pro largely ignores emotion tags.
PROMPT_WAV=/root/cosyvoice-wyoming/voices/nicoleheart.wav
PROMPT_TEXT="The day had gently ended. In the soft room, the person lay down. Slowly, the light faded over the floor. Eyes drifted shut and the body relaxed. Thoughts slowed and turned soft. Warmth spread through the sheets and the body let go, drifting into sleep."
VOICE=nicoleheart

# Tag for text before any mood tag (e.g. warm). Empty: none.
DEFAULT_MOOD=

# Wyoming listen address (CosyVoice uses 10214).
URI=tcp://0.0.0.0:10215

# Model
MODEL_ID=fishaudio/s2-pro
MODEL_DIR=models/s2-pro
# PyTorch build: cu126, cu128 or cu129
TORCH_EXTRA=cu128

# 1 = on, 0 = off. INT8: ~6.9 GB VRAM instead of ~10.2 GB and ~1.5x faster.
# COMPILE: ~1.5x faster decoding; the first start compiles for a few minutes.
INT8=1
COMPILE=1

# Sampling (fish-speech defaults 0.7 / 0.7). SEED=-1 for random.
TEMPERATURE=0.7
TOP_P=0.7
SEED=42

# Streaming: audio held before playback starts, and how much speech to merge
# per model call after the first sentence.
PREBUFFER_SECONDS=1
MIN_MERGED_SECONDS=3

# Anything else for bridge_s2.py, e.g. EXTRA_ARGS="--top-k 20"
EXTRA_ARGS=

[Unit]
Description=Fish Audio S2 Pro Wyoming TTS bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/fish
# Settings live in /root/fish/.env, which run.sh sources itself.
ExecStart=/root/fish/run.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
